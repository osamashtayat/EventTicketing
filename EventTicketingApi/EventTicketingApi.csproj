<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b1de0eb6-a5e3-4e19-8037-4d2e961c599b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventTicketingApi.Application\EventTicketingApi.Application.csproj" />
    <ProjectReference Include="..\EventTicketingApi.Common\EventTicketingApi.Common.csproj" />
    <ProjectReference Include="..\EventTicketingApi.Infrastructure\EventTicketingApi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
